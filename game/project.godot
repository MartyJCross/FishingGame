; Engine configuration file.
; Edited by hand and by the Godot editor. Keep it small: input actions are registered in code
; (src/Input/InputActions.cs) so they can be rebound and reviewed in one place.

config_version=5

[application]

config/name="The Ledger"
config/version="0.4.8"
config/description="A physically simulated fishing game with real fish in real places."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Windowed here; Main switches to fullscreen at start unless it's an automated run (owner wants fullscreen).
; V-Sync off so the frame rate isn't pinned to 60 (Mailbox isn't offered by every driver). --max-fps N caps it.
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="TheLedger"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_2d=1
